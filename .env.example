# Environment variables for DevConnect
# Copy this file to .env and fill in real values (never commit .env)

# ── MongoDB ──────────────────────────────────────────────────────────────────
# How to get: create a free cluster at https://cloud.mongodb.com
# Click "Connect" → "Drivers" → copy the connection string, replace <password>
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/devconnect?retryWrites=true&w=majority

# ── Session ───────────────────────────────────────────────────────────────────
# Any long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_string

# ── Firebase / Gmail Email ────────────────────────────────────────────────────
# DevConnect uses Gmail SMTP (via your Firebase/Google account) to send emails.
#
# Steps:
#   1. Use the Gmail address linked to your Firebase project (devconnect-9949c)
#   2. Enable 2-Step Verification: https://myaccount.google.com/security
#   3. Generate a Gmail App Password:
#      Google Account → Security → 2-Step Verification → App passwords
#      App: "Mail"  Device: "Other (DevConnect)"  → copy the 16-char password
#   4. Paste values below (no spaces in the app password)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=abcdabcdabcdabcd

# ── App base URL ──────────────────────────────────────────────────────────────
# Local development:
APP_URL=http://localhost:3000
# On Render, set this to your service URL, e.g.:
# APP_URL=https://devconnect.onrender.com

# ── Node environment ──────────────────────────────────────────────────────────
# "development" locally, "production" on Render
NODE_ENV=development

# ── Port ──────────────────────────────────────────────────────────────────────
# Render sets PORT automatically. Locally use 3000.
PORT=3000
